# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Install dependencies first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Generate ent ORM client code
RUN go generate ./ent/...

# Build the channel-service binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /channel-service ./cmd/channel-service/main.go

# Final stage
FROM alpine:latest
WORKDIR /app

# Copy binary from builder
COPY --from=builder /channel-service /app/channel-service

# Expose port
EXPOSE 8081

CMD ["/app/channel-service"]
