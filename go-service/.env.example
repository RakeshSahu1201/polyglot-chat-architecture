AUTH_PORT=8080
CHANNEL_PORT=8081
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change_this_to_a_strong_secret_in_production

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=chatuser
PG_PASSWORD=chatpass
PG_DB=chatdb
PG_SSLMODE=disable

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Shared media service
MEDIA_SERVICE_URL=http://127.0.0.1:5000

# MongoDB for worker cleanup jobs
MONGO_URI=mongodb://127.0.0.1:27017/chat
MONGO_DB=chat

# Worker cleanup settings
WORKER_MESSAGE_TTL_HOURS=24
WORKER_MESSAGE_SWEEP_MINUTES=10
WORKER_CHANNEL_INACTIVE_HOURS=720
WORKER_CHANNEL_SWEEP_MINUTES=60
WORKER_MEDIA_SWEEP_MINUTES=30
WORKER_MEDIA_GRACE_HOURS=1

# IPFS / Pinning cleanup
IPFS_API_URL=http://127.0.0.1:5001
PINATA_JWT=
