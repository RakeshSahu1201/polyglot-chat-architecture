# Pre-Production Environment Variables
# Copy this to .env.preprod and fill in your actual values

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
NODE_ENV=preprod
CORS_ORIGIN=http://localhost
SERVER_BASE_URL=http://localhost
JWT_SECRET=your_preprod_jwt_secret_here_change_this

# ============================================================================
# SUPABASE POSTGRESQL (Managed Database)
# Get these from: https://app.supabase.com/project/[PROJECT_ID]/settings/database
# ============================================================================
SUPABASE_HOST=db.xxxxx.supabase.co
SUPABASE_PORT=5432
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your_supabase_password_here
SUPABASE_DB=postgres

# ============================================================================
# MONGODB ATLAS (Managed MongoDB)
# Get this from: https://cloud.mongodb.com/v2/[PROJECT_ID]/clusters
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# ============================================================================
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/chat?retryWrites=true&w=majority

# ============================================================================
# PINATA (IPFS Storage)
# Get these from: https://app.pinata.cloud/keys
# ============================================================================
PINATA_JWT=your_pinata_jwt_token_here
PINATA_API_URL=https://api.pinata.cloud

# ============================================================================
# FRONTEND BUILD ARGS
# ============================================================================
VITE_AUTH_URL=http://localhost/api/auth
VITE_CHANNEL_URL=http://localhost/api/channels
VITE_SERVER_URL=http://localhost/api/chat
VITE_IPFS_GATEWAY_URL=http://localhost/ipfs

# ============================================================================
# NOTES
# ============================================================================
# 1. Supabase: Sign up at https://supabase.com
#    - Create a new project
#    - Go to Settings > Database to get connection details
#    - Enable SSL (change PG_SSLMODE=require)
#
# 2. MongoDB Atlas: Sign up at https://www.mongodb.com/cloud/atlas
#    - Create a cluster
#    - Get connection string from "Connect > Connect your application"
#    - Make sure IP whitelist includes your machine
#
# 3. Pinata: Sign up at https://www.pinata.cloud
#    - Go to API Keys > Create Key
#    - Copy the JWT token
#
# 4. To use this setup:
#    cp .env.preprod.example .env.preprod
#    # Edit .env.preprod with your actual values
#    docker-compose -f docker-compose.preprod.yml --env-file .env.preprod up -d
